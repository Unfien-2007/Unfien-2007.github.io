---
layout: compress
swcache: true
---

{% assign items = site.posts | concat: site.projects %}

[
  {% for item in items %}
  {% if item.collection == 'posts' %}
    {% assign post = item %}
    {% capture content -%}{% include post-summary.html full_text=true %}{%- endcapture -%}
  {% else %}
    {% capture content -%}{{ item.description | default: '' | strip_html }}{%- endcapture -%}
  {% endif %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "type": {{ item.collection | jsonify }},
    "categories": {{ item.categories | default: '' | join: ', ' | jsonify }},
    "tags": {{ item.tags | default: '' | join: ', ' | jsonify }},
    "date": {{ item.date | jsonify }},
    "content": {{ content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
